# Add provider credentials only on the server/Vercel. Never expose secrets with NEXT_PUBLIC_.
# OpenRouter: create a key at https://openrouter.ai/ and add it in Vercel as OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
# Optional model override; defaults to openrouter/auto.
OPENROUTER_MODEL=openrouter/auto
# Public commercial display of third-party market data requires the provider's correct business plan
# and any exchange/redistribution permissions. Do not enable a feed until those rights are confirmed.
# TWELVEDATA_API_KEY=
# BROKER_API_KEY=
# BROKER_API_SECRET=
